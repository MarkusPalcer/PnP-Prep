\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pnp-decision}[2026/08/01 Simplified Decision Environments]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{tcolorbox}
\RequirePackage{xcolor}
\RequirePackage{pnp-structuredbox}

% -----------------------------------------------------------------------------
% Visual palette
% -----------------------------------------------------------------------------
% Colors for decision sections
\definecolor{questionblue}{RGB}{220,235,250}
\definecolor{resultgreen}{RGB}{220,245,220}
\definecolor{resultred}{RGB}{250,220,220}

\ExplSyntaxOn

% -----------------------------------------------------------------------------
% Global decision state (collect phase)
% -----------------------------------------------------------------------------
% Tracks whether parser is currently inside a decision block.
\bool_new:N \g__pnp_decision_inside_bool
% Number of captured condition blocks (must be exactly 1).
\int_new:N \g__pnp_decision_condition_count_int
% Captured condition body.
\tl_new:N \g__pnp_decision_condition_body_tl
% Captured pass entries (parallel title/body sequences).
\seq_new:N \g__pnp_decision_pass_titles_seq
\seq_new:N \g__pnp_decision_pass_bodies_seq
% Captured fail entries (parallel title/body sequences).
\seq_new:N \g__pnp_decision_fail_titles_seq
\seq_new:N \g__pnp_decision_fail_bodies_seq
% Sink box for free text in decision body (intentionally ignored).
\box_new:N \g__pnp_decision_sink_box
% Scratch dimension for multi-entry title-column width calculation.
\dim_new:N \l__pnp_decision_max_title_dim

% -----------------------------------------------------------------------------
% Diagnostics
% -----------------------------------------------------------------------------
\msg_new:nnn { pnp-decision } { child-outside-decision }
  { #1~may~only~appear~directly~inside~a~decision~environment. }

\msg_new:nnn { pnp-decision } { nested-child }
  {
    Child~environments~must~not~be~nested.~Found~a~child~environment~inside~#1.\\
    Move~child~environments~so~they~are~direct~children~of~decision.
  }

\msg_new:nnn { pnp-decision } { missing-condition }
  {
    A~decision~environment~must~contain~exactly~one~condition~environment.\\
    Add~one~condition~entry~inside~the~decision~block.
  }

\msg_new:nnn { pnp-decision } { too-many-conditions }
  {
    A~decision~environment~cannot~contain~more~than~one~condition~environment.\\
    Keep~exactly~one~condition~entry.
  }

\msg_new:nnn { pnp-decision } { missing-pass }
  {
    A~decision~environment~must~contain~at~least~one~pass~environment.\\
    Add~one~or~more~pass~entries.
  }

\msg_new:nnn { pnp-decision } { missing-fail }
  {
    A~decision~environment~must~contain~at~least~one~fail~environment.\\
    Add~one~or~more~fail~entries.
  }

% -----------------------------------------------------------------------------
% Collect-phase helpers
% -----------------------------------------------------------------------------
% Reset all decision-local state at begin{decision}.
\cs_new_protected:Npn \__pnp_decision_reset:
  {
    \int_gzero:N \g__pnp_decision_condition_count_int
    \tl_gclear:N \g__pnp_decision_condition_body_tl
    \seq_gclear:N \g__pnp_decision_pass_titles_seq
    \seq_gclear:N \g__pnp_decision_pass_bodies_seq
    \seq_gclear:N \g__pnp_decision_fail_titles_seq
    \seq_gclear:N \g__pnp_decision_fail_bodies_seq
  }

% Guard against nested condition/pass/fail blocks inside child bodies.
\cs_new_protected:Npn \__pnp_decision_check_nested:nn #1#2
  {
    \tl_set:Nx \l_tmpa_tl { \tl_to_str:n {#2} }
    \regex_match:nnT { \\begin\{(?:condition|pass|fail)\} } { \l_tmpa_tl }
      { \msg_error:nnn { pnp-decision } { nested-child } { #1 } }
  }

% Capture a condition body (cardinality checked later in validation phase).
\cs_new_protected:Npn \__pnp_decision_add_condition:n #1
  {
    \bool_if:NF \g__pnp_decision_inside_bool
      { \msg_error:nnn { pnp-decision } { child-outside-decision } { condition } }
    \__pnp_decision_check_nested:nn { condition } { #1 }
    \int_gincr:N \g__pnp_decision_condition_count_int
    \tl_gset:Nn \g__pnp_decision_condition_body_tl { #1 }
  }

% Capture one pass tuple: [title] + body.
\cs_new_protected:Npn \__pnp_decision_add_pass:nn #1#2
  {
    \bool_if:NF \g__pnp_decision_inside_bool
      { \msg_error:nnn { pnp-decision } { child-outside-decision } { pass } }
    \__pnp_decision_check_nested:nn { pass } { #2 }
    \seq_gput_right:Nn \g__pnp_decision_pass_titles_seq { #1 }
    \seq_gput_right:Nn \g__pnp_decision_pass_bodies_seq { #2 }
  }

% Capture one fail tuple: [title] + body.
\cs_new_protected:Npn \__pnp_decision_add_fail:nn #1#2
  {
    \bool_if:NF \g__pnp_decision_inside_bool
      { \msg_error:nnn { pnp-decision } { child-outside-decision } { fail } }
    \__pnp_decision_check_nested:nn { fail } { #2 }
    \seq_gput_right:Nn \g__pnp_decision_fail_titles_seq { #1 }
    \seq_gput_right:Nn \g__pnp_decision_fail_bodies_seq { #2 }
  }

% -----------------------------------------------------------------------------
% Validation phase
% -----------------------------------------------------------------------------
% Enforce required structure before rendering output.
\cs_new_protected:Npn \__pnp_decision_validate:
  {
    \pnp_struct_require_exactly_one:nnnn
      { \g__pnp_decision_condition_count_int }
      { pnp-decision }
      { missing-condition }
      { too-many-conditions }
    \pnp_struct_require_at_least_one:nnn
      { \seq_count:N \g__pnp_decision_pass_bodies_seq }
      { pnp-decision }
      { missing-pass }
    \pnp_struct_require_at_least_one:nnn
      { \seq_count:N \g__pnp_decision_fail_bodies_seq }
      { pnp-decision }
      { missing-fail }
  }

% -----------------------------------------------------------------------------
% Render helpers
% -----------------------------------------------------------------------------
% Single-entry layout: optional right-aligned title above body.
\cs_new_protected:Npn \__pnp_decision_render_single:nn #1#2
  {
    \tl_if_blank:nF { #1 }
      {
        \noindent\makebox[\linewidth][r]{\textbf{#1}}\par
        \smallskip
      }
    \noindent #2\par
  }

% Multi-entry layout:
% - compute max title width per section,
% - render right-aligned title column + body column,
% - separate entries with thin horizontal rules.
\cs_new_protected:Npn \__pnp_decision_render_multi:NN #1#2
  {
    \dim_zero:N \l__pnp_decision_max_title_dim
    \seq_map_inline:Nn #1
      {
        \hbox_set:Nn \l_tmpa_box { \textbf{##1} }
        \dim_set:Nn \l__pnp_decision_max_title_dim
          { \dim_max:nn { \l__pnp_decision_max_title_dim } { \box_wd:N \l_tmpa_box } }
      }

    \int_step_inline:nn { \seq_count:N #2 }
      {
        \int_compare:nNnT { ##1 } > { 1 }
          { \pnp_struct_render_thin_separator: }

        \noindent
        \makebox[\l__pnp_decision_max_title_dim][r]
          { \textbf{\seq_item:Nn #1 { ##1 }} }
        \hspace{0.75em}
        \parbox[t]
          { \dim_eval:n { \linewidth - \l__pnp_decision_max_title_dim - 0.75em } }
          { \seq_item:Nn #2 { ##1 } }
        \par
      }
  }

% Dispatch to single- vs multi-entry renderer.
\cs_new_protected:Npn \__pnp_decision_render_entries:NN #1#2
  {
    \int_compare:nNnTF { \seq_count:N #2 } = { 1 }
      {
        \__pnp_decision_render_single:nn
          { \seq_item:Nn #1 { 1 } }
          { \seq_item:Nn #2 { 1 } }
      }
      { \__pnp_decision_render_multi:NN #1 #2 }
  }

% Compose final decision output in deterministic section order:
% condition -> pass -> fail.
\cs_new_protected:Npn \__pnp_decision_render:
  {
    \begin{center}
      \begin{tcolorbox}[
        enhanced,
        breakable,
        width=0.9\linewidth,
        colback=white,
        colframe=black,
        boxrule=0.8pt,
        boxsep=0pt,
        left=0pt,
        right=0pt,
        top=0pt,
        bottom=0pt
      ]
        \begin{tcolorbox}[
          enhanced,
          breakable,
          colback=questionblue,
          colframe=questionblue,
          boxrule=0pt,
          left=6pt,right=6pt,top=6pt,bottom=6pt
        ]
          {\noindent\bfseries \g__pnp_decision_condition_body_tl\par}
        \end{tcolorbox}

        \par\nointerlineskip\noindent\rule{\linewidth}{1.1pt}\par\nointerlineskip

        \begin{tcolorbox}[
          enhanced,
          breakable,
          colback=resultgreen,
          colframe=resultgreen,
          boxrule=0pt,
          left=6pt,right=6pt,top=6pt,bottom=6pt
        ]
          \__pnp_decision_render_entries:NN
            \g__pnp_decision_pass_titles_seq
            \g__pnp_decision_pass_bodies_seq
        \end{tcolorbox}

        \par\nointerlineskip\noindent\rule{\linewidth}{1.1pt}\par\nointerlineskip

        \begin{tcolorbox}[
          enhanced,
          breakable,
          colback=resultred,
          colframe=resultred,
          boxrule=0pt,
          left=6pt,right=6pt,top=6pt,bottom=6pt
        ]
          \__pnp_decision_render_entries:NN
            \g__pnp_decision_fail_titles_seq
            \g__pnp_decision_fail_bodies_seq
        \end{tcolorbox}
      \end{tcolorbox}
    \end{center}
  }

% -----------------------------------------------------------------------------
% Public environments (API)
% -----------------------------------------------------------------------------
% decision: collect children, then validate + render on close.
\NewDocumentEnvironment { decision } { }
  {
    \__pnp_decision_reset:
    \bool_gset_true:N \g__pnp_decision_inside_bool
    \setbox\g__pnp_decision_sink_box=\vbox\bgroup
    \ignorespaces
  }
  {
    \unskip\egroup
    \bool_gset_false:N \g__pnp_decision_inside_bool
    \__pnp_decision_validate:
    \__pnp_decision_render:
  }

% condition: required exactly once (checked in validation phase).
\NewDocumentEnvironment { condition } { +b }
  { \__pnp_decision_add_condition:n { #1 } }
  { }

% pass: required at least once; optional title in [..].
\NewDocumentEnvironment { pass } { O{} +b }
  { \__pnp_decision_add_pass:nn { #1 } { #2 } }
  { }

% fail: required at least once; optional title in [..].
\NewDocumentEnvironment { fail } { O{} +b }
  { \__pnp_decision_add_fail:nn { #1 } { #2 } }
  { }

\ExplSyntaxOff
