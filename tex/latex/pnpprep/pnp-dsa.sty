\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pnp-dsa}[2026/08/02 Templates for DSA]

\begin{databox}{gegner}
    \field{name}

    \field[optional]{MU}
    \field[optional]{KL}
    \field[optional]{IN}
    \field[optional]{CH}
    \field[optional]{FF}
    \field[optional]{GE}
    \field[optional]{KO}
    \field[optional]{KK}

    \field{waffe}
    \field{AT}
    \field[optional]{PA}
    \field{TP}

    \field[optional]{ruestung}
    \field[optional]{RS}

    \begin{render}
        \begin{FlexibleBox}{\namevalue}
            \ifpresent{MU}{\textbf{MU: }\MUvalue\hfill}
            \ifpresent{KL}{\textbf{KL: }\KLvalue\hfill}
            \ifpresent{IN}{\textbf{IN: }\INvalue\hfill}
            \ifpresent{CH}{\textbf{CH: }\CHvalue\hfill}
            \ifpresent{FF}{\textbf{FF: }\FFvalue\hfill}
            \ifpresent{GE}{\textbf{GE: }\GEvalue\hfill}
            \ifpresent{KO}{\textbf{KO: }\KOvalue\hfill}
            \ifpresent{KK}{\textbf{KK: }\KKvalue\hfill}
            \par

            \textbf{\waffevalue :}\quad
            \textbf{AT: }\ATvalue\quad
            \ifpresent{PA}{\textbf{PA: }\PAvalue}\quad
            \textbf{TP: }\TPvalue\quad
            \par
            
            \ifpresent{ruestung}{
                \textbf{\ruestungvalue :}\quad
                \ifpresent{RS}{\textbf{RS: }\RSvalue}\quad
                \ifmissing{RS}{\textbf{RS: }0}\quad
                \par
            }
        \end{FlexibleBox}
    \end{render}
\end{databox}
