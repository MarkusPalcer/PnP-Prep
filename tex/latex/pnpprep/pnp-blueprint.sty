% -----------------------------------------------------------------------------
% pnp-blueprint
% -----------------------------------------------------------------------------
%
% This package provides a framework for defining reusable document components
% ("blueprints") which can later be instantiated as environments with structured
% data and customizable rendering.
%
% The implementation is split into several internal modules. This file acts as
% the public package entry point and is responsible for loading required
% dependencies and assembling the internal components.
%
% -----------------------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pnp-blueprint}

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{pnp-panel}

\ExplSyntaxOn

% Error and warning messages used by the pnp-blueprint framework.
\input{blueprint/messages}

% -----------------------------------------------------------------------------
% Internal helper functions
% -----------------------------------------------------------------------------

% -----------------------------------------------------------------------------
% Summary:
%   Checks whether a name is available for creating a new command or environment.
%
% Description:
%   Verifies that no existing control sequence or environment end command uses
%   the given name. If the name is already in use, an error is raised.
%
% Parameters:
%   #1
%     The name to check for availability.
%
% -----------------------------------------------------------------------------
\cs_new_protected:Npn \__pnp_blueprint_assert_name_available:n #1
  {
    \cs_if_exist:cTF {#1}
      { \msg_error:nnn { pnp-blueprint } { name-already-exists } {#1} }
      {
        \cs_if_exist:cT { end#1 }
          { \msg_error:nnn { pnp-blueprint } { name-already-exists } {#1} }
      }
  }

% Internal data structures used to store blueprint definition and instance state.
\input{blueprint/state}

% Field declaration, value storage, validation, and access functionality.
\input{blueprint/fields}

% Rendering definition and execution support for blueprint instances.
\input{blueprint/render}

% Support for registering and rendering nested child blueprint instances.
\input{blueprint/children}

% Generation and execution of environments created from blueprint definitions.
\input{blueprint/instance}

% Implementation of \load<Type> command
\input{blueprint/load}

% -----------------------------------------------------------------------------
% Summary:
%   Defines the blueprint declaration environment.
%
% Description:
%   Collects fields, child environment registrations, and the render definition
%   of a blueprint. After the declaration is complete, the collected information
%   is used to generate the runtime environment for blueprint instances.
%
% Parameters:
%   #1
%     The name of the generated blueprint environment.
%
%   #2
%     The blueprint definition body containing field, child, and render
%     declarations.
%
% -----------------------------------------------------------------------------
\NewDocumentEnvironment { blueprint } { m +b }
  {
    \__pnp_blueprint_assert_name_available:n {#1}
    \seq_clear:N \l__pnp_blueprint_field_names_seq
    \tl_clear:N \l__pnp_blueprint_field_setters_tl
    \tl_clear:N \l__pnp_blueprint_field_required_checks_tl
    \tl_clear:N \l__pnp_blueprint_field_render_value_commands_tl
    \bool_set_false:N \l__pnp_blueprint_render_environment_is_set_bool
    \tl_clear:N \l__pnp_blueprint_render_body_tl
    \tl_clear:N \l__pnp_blueprint_child_environment_definitions_tl

    \DeclareDocumentCommand \field { O{} m }
      {
        \__pnp_blueprint_declare_field:nn {##1} {##2}
      }

    \DeclareDocumentCommand \registerChildEnvironment { m m }
      {
        \__pnp_blueprint_register_child_environment:nn {##1}{##2}
      }

    \NewDocumentEnvironment { render } { +b }
      { \__pnp_blueprint_declare_render:n {##1} }
      { }

    #2
  }
  {
    \bool_if:NF \l__pnp_blueprint_render_environment_is_set_bool
      {
        \msg_error:nnnn { pnp-blueprint } { item-must-be-present }
          { Environment } { render }
      }
    \tl_set:Nx \l__pnp_blueprint_generated_begin_code_tl
    {
      \exp_not:V \l__pnp_blueprint_child_environment_definitions_tl
      \exp_not:V \l__pnp_blueprint_field_setters_tl
    }
    \tl_set:Nx \l__pnp_blueprint_generated_end_code_tl
      {
        \exp_not:V \l__pnp_blueprint_field_render_value_commands_tl
        \exp_not:N \__pnp_blueprint_define_ifpresent_command:
        \exp_not:N \__pnp_blueprint_define_ifmissing_command:
        \exp_not:N \__pnp_blueprint_define_render_children_command:
        \exp_not:V \l__pnp_blueprint_render_body_tl
      }
    \exp_args:Noooo \__pnp_blueprint_define_generated_environment:nnnn
      {#1}
      {\l__pnp_blueprint_generated_begin_code_tl}
      {\l__pnp_blueprint_field_required_checks_tl}
      {\l__pnp_blueprint_generated_end_code_tl}
  }


\ExplSyntaxOff