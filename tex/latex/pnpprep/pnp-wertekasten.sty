\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pnp-wertekasten}[2026/07/30 Wertekasten Environment]

\RequirePackage{xparse}
\RequirePackage{pnp-flexiblebox}

% Wertekasten für Gegner
\NewDocumentEnvironment{Wertekasten}{m}
{%
\begin{FlexibleBox}{#1}

\NewDocumentCommand{\wert}{m m}{%
    \textbf{##1:}\hspace{1em}##2\hspace{2em}%
}

\NewDocumentCommand{\waffe}{m m m m m}{%
    \textbf{##1:}\hspace{1em}%
    \wert{AT}{##2}%
    \wert{PA}{##3}%
    \wert{TP}{##4}%
    \wert{INI}{##5}%
    \\%
}

\NewDocumentCommand{\ruestung}{m m}{%
    \wert{Rüstung}{##1}%
    \wert{RS}{##2}%
    \\%
}
}
{%
\end{FlexibleBox}
}
