\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pnp-databox}[2026/08/01 Databox Templates]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{flexiblebox}

\ExplSyntaxOn

\msg_new:nnn { pnp-databox } { name-already-exists }
  {
    Cannot~create~databox~environment~'#1':~a~command~or~environment~with~this~name~already~exists.
  }

\msg_new:nnn { pnp-databox } { item-used-multiple-times }
  {
    #1~'#2'~may~occur~once.
  }

\msg_new:nnn { pnp-databox } { item-must-be-present }
  {
    #1~'#2'~must~be~present.
  }

\seq_new:N \l__pnp_databox_field_names_seq
\prop_new:N \l__pnp_databox_field_values_prop
\tl_new:N \l__pnp_databox_field_setters_tl
\tl_new:N \l__pnp_databox_field_required_checks_tl
\tl_new:N \l__pnp_databox_field_render_value_commands_tl
\tl_new:N \l__pnp_databox_generated_end_code_tl
\bool_new:N \l__pnp_databox_field_optional_bool
\tl_new:N \l__pnp_databox_field_value_tl
\bool_new:N \l__pnp_databox_render_environment_is_set_bool
\tl_new:N \l__pnp_databox_render_body_tl

\keys_define:nn { pnp-databox / field }
  {
    optional .bool_set:N = \l__pnp_databox_field_optional_bool,
    optional .default:n = true,
    optional .initial:n = false
  }

\cs_new_protected:Npn \__pnp_databox_assert_name_available:n #1
  {
    \cs_if_exist:cTF {#1}
      { \msg_error:nnn { pnp-databox } { name-already-exists } {#1} }
      {
        \cs_if_exist:cT { end#1 }
          { \msg_error:nnn { pnp-databox } { name-already-exists } {#1} }
      }
  }

\cs_new_protected:Npn \__pnp_databox_declare_field:n #1
  {
    \__pnp_databox_assert_name_available:n {#1}
    \seq_if_in:NnTF \l__pnp_databox_field_names_seq {#1}
      {
        \msg_error:nnnn { pnp-databox } { item-used-multiple-times }
          { Field } {#1}
      }
      {
        \seq_put_right:Nn \l__pnp_databox_field_names_seq {#1}
        \tl_put_right:Nn \l__pnp_databox_field_setters_tl
          { \__pnp_databox_define_field_setter:n {#1} }
        \bool_if:NF \l__pnp_databox_field_optional_bool
          {
            \tl_put_right:Nn \l__pnp_databox_field_required_checks_tl
              { \__pnp_databox_assert_field_is_set:n {#1} }
          }
        \tl_put_right:Nn \l__pnp_databox_field_render_value_commands_tl
          { \__pnp_databox_define_field_value_command:n {#1} }
      }
  }

\cs_new_protected:Npn \__pnp_databox_declare_field:nn #1#2
  {
    \bool_set_false:N \l__pnp_databox_field_optional_bool
    \keys_set:nn { pnp-databox / field } {#1}
    \__pnp_databox_declare_field:n {#2}
  }

\cs_new_protected:Npn \__pnp_databox_declare_render:n #1
  {
    \bool_if:NTF \l__pnp_databox_render_environment_is_set_bool
      {
        \msg_error:nnnn { pnp-databox } { item-used-multiple-times }
          { Environment } { render }
      }
      {
        \bool_gset_true:N \l__pnp_databox_render_environment_is_set_bool
        \tl_gset:Nn \l__pnp_databox_render_body_tl {#1}
      }
  }

\cs_new_protected:Npn \__pnp_databox_define_field_setter:n #1
  {
    \cs_set_protected:cpn {#1} ##1
      {
        \prop_if_in:NnTF \l__pnp_databox_field_values_prop {#1}
          {
            \msg_error:nnnn { pnp-databox } { item-used-multiple-times }
              { Field } {#1}
          }
          {
            \prop_put:Nnn \l__pnp_databox_field_values_prop {#1} {##1}
          }
      }
  }

\cs_new_protected:Npn \__pnp_databox_assert_field_is_set:n #1
  {
    \prop_if_in:NnF \l__pnp_databox_field_values_prop {#1}
      {
        \msg_error:nnnn { pnp-databox } { item-must-be-present }
          { Field } {#1}
      }
  }

\cs_new_protected:Npn \__pnp_databox_define_field_value_command:n #1
  {
    \cs_set:cpn {#1value}
      {
        \prop_get:NnNTF \l__pnp_databox_field_values_prop {#1} \l__pnp_databox_field_value_tl
          { \tl_use:N \l__pnp_databox_field_value_tl }
          { }
      }
  }

\cs_new_protected:Npn \__pnp_databox_define_generated_environment:nnnn #1#2#3#4
  {
    \group_begin:
      \tex_globaldefs:D = 1\scan_stop:
      \exp_args:No \NewDocumentEnvironment {#1} { }
        {
          \prop_clear:N \l__pnp_databox_field_values_prop
          #2
        }
        {
          #3
          #4
        }
    \group_end:
  }

\NewDocumentEnvironment { databox } { m +b }
  {
    \__pnp_databox_assert_name_available:n {#1}
    \seq_clear:N \l__pnp_databox_field_names_seq
    \tl_clear:N \l__pnp_databox_field_setters_tl
    \tl_clear:N \l__pnp_databox_field_required_checks_tl
    \tl_clear:N \l__pnp_databox_field_render_value_commands_tl
    \bool_set_false:N \l__pnp_databox_render_environment_is_set_bool
    \tl_clear:N \l__pnp_databox_render_body_tl
    \DeclareDocumentCommand \field { O{} m }
      {
        \__pnp_databox_declare_field:nn {##1} {##2}
      }
    \NewDocumentEnvironment { render } { +b }
      { \__pnp_databox_declare_render:n {##1} }
      { }
    #2
  }
  {
    \bool_if:NF \l__pnp_databox_render_environment_is_set_bool
      {
        \msg_error:nnnn { pnp-databox } { item-must-be-present }
          { Environment } { render }
      }
    \tl_set:Nx \l__pnp_databox_generated_end_code_tl
      {
        \exp_not:V \l__pnp_databox_field_render_value_commands_tl
        \exp_not:V \l__pnp_databox_render_body_tl
      }
    \exp_args:Noooo \__pnp_databox_define_generated_environment:nnnn
      {#1}
      {\l__pnp_databox_field_setters_tl}
      {\l__pnp_databox_field_required_checks_tl}
      {\l__pnp_databox_generated_end_code_tl}
  }


\ExplSyntaxOff