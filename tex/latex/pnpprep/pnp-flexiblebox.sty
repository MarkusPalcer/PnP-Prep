\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pnp-flexiblebox}[2026/07/30 Flexible Box Environment]

\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{xparse}

% Pergamentfarben
\definecolor{PergamentHell}{RGB}{245,238,220}
\definecolor{PergamentDunkel}{RGB}{173,140,82}

% Flexible Box
\NewDocumentEnvironment{FlexibleBox}{m O{PergamentHell} O{PergamentDunkel} O{white}}
{%
  \if@nobreak
    \everypar{}%
  \fi
  \par
  \begin{tcolorbox}[
    width=\linewidth,
    colback=#2,
    colframe=#3,
    coltitle=#4,
    colbacktitle=#3,
    fonttitle=\bfseries,
    title=#1,
    boxrule=0.5pt,
    arc=2mm,
    left=2mm,
    right=2mm,
    top=1mm,
    bottom=1mm
  ]
}
{%
  \end{tcolorbox}
  \par
}
